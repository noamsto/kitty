+extern PyTypeObject Screen_Type;
+
+// Uploads repeat frames of the screen without a GPU, returning the cell data of the last
+static PyObject *
+test_screen_update_cell_data(PyObject UNUSED *self, PyObject *args) {
+    Screen *screen;
+    unsigned int repeat = 1;
+    if (!PyArg_ParseTuple(args, "O!|I", &Screen_Type, &screen, &repeat)) return NULL;
+    if (!num_font_groups) {
+        PyErr_SetString(PyExc_RuntimeError, "must create font group first");
+        return NULL;
+    }
+    PyObject *ans = PyBytes_FromStringAndSize(NULL, (Py_ssize_t)(sizeof(CellGPUData) * render_lines_for_screen(screen) * screen->columns));
+    if (!ans) return NULL;
+    memset(PyBytes_AS_STRING(ans), 0, PyBytes_GET_SIZE(ans));
+    for (unsigned int i = 0; i < repeat; i++) screen_update_cell_data(screen, PyBytes_AS_STRING(ans), (FONTS_DATA_HANDLE)font_groups, false);
+    return ans;
+}
